# ============================================================
# Coin11 Control Backend 配置示例（复制为 .env 后按需修改）
# 注意：本文件不含任何真实密钥，仅为占位示例。
#       .env 已被 .gitignore 忽略，请勿提交真实 .env。
#       .env 必须保存为 UTF-8 编码（config.py 声明 env_file_encoding="utf-8"）
# ============================================================

# coin11-tb 脚本目录路径；留空则使用后端项目根目录下的 coin11_tb/
# COIN11_TB_PATH=

# coin11-tb 远程仓库地址（repo_manager 首次启动时自动 clone）
COIN11_TB_REPO_URL=https://github.com/czl0325/coin11-tb.git

# ADB 可执行文件路径（在 PATH 中可保持默认值 adb）
ADB_PATH=adb

# 服务监听地址（默认仅本机回环，改为 0.0.0.0 时请务必设置 API_AUTH_TOKEN）
HOST=127.0.0.1

# 服务监听端口
PORT=8000

# CORS 允许的来源，JSON 数组格式
# 注意：包含 "*" 时服务端会强制关闭 allow_credentials（浏览器禁止 wildcard+credentials 组合）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# WebSocket 鉴权 Token（连接 /ws/device/{id}?token=xxx）
# 前端 submodule 当前硬编码默认值；生产环境必须改为强随机值
WS_AUTH_TOKEN=coin11-control-token

# API 鉴权 Token（可选）：
# 设置后，所有 /api/* 请求必须携带 Authorization: Bearer <token> 或 X-API-Token 头，
# /api/health 始终豁免（供健康检查使用）。留空则 API 完全开放（本地单用户场景）。
API_AUTH_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
