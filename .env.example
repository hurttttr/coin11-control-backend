# ============================================
# Coin11-TB 控制平台后端 环境变量示例
# 复制本文件为 .env 后按需修改
# ============================================

# coin11-tb 内置路径（空=使用项目根目录 coin11_tb/）
COIN11_TB_PATH=
# coin11-tb 远程仓库地址
COIN11_TB_REPO_URL=https://github.com/czl0325/coin11-tb.git
# ADB 可执行文件路径
ADB_PATH=adb
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# DeepSeek API Key（可选）
DEEPSEEK_API_KEY=
# WebSocket 鉴权 Token
WS_AUTH_TOKEN=coin11-control-token
# HTTP API 鉴权 Token（留空=不启用；启用后请求需带 X-Auth-Token 头）
AUTH_TOKEN=
# 任务状态持久化文件路径（可选，默认项目根目录 task_state.json）
COIN11_STATE_FILE=
# 自动任务配置文件路径（可选，默认项目根目录 auto_task_settings.json）
AUTO_TASK_SETTINGS_FILE=
